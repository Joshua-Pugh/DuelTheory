{
  "name": "dueltheory",
  "version": "3.9.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync:cards": "node scripts/sync-cards.mjs",
    "test": "vitest run",
    "sync:all-images": "node scripts/sync-cards.mjs --all-images",
    "build:pages": "npm run build -- --base=/ && node scripts/prepare-pages.mjs",
    "dev:mobile": "vite --config vite.mobile.config.ts --host 127.0.0.1 --port 5199 --open /mobile/index.html",
    "build:mobile": "tsc -b && vite build --config vite.mobile.config.ts && node scripts/prepare-mobile.mjs",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.4.3",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "21.0.4",
    "jsqr": "1.4.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.3",
    "vitest": "^5.0.5"
  }
}
