# Public values only. Never place secret/service-role keys in VITE_ variables.
# Enable only after SQL, email, deletion and cross-user tests pass.
VITE_ACCOUNTS_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional internal AT preview; leave false for the initial store build.
VITE_MOBILE_AT_PREVIEW=false
