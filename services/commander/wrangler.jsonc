{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"dueltheory-commander",
 "main":"worker.ts",
 "compatibility_date":"2026-10-17",
 "durable_objects":{"bindings":[{"name":"COMMANDER_ROOMS","class_name":"CommanderRoom"},{"name":"EVENT_HUBS","class_name":"EventHub"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["CommanderRoom"]},{"tag":"v2-event-hub","new_sqlite_classes":["EventHub"]}],
 "ratelimits":[{"name":"ROOM_LIMITER","namespace_id":"1001","simple":{"limit":30,"period":60}}],
 "vars":{"ALLOWED_ORIGINS":"https://joshua-pugh.github.io,https://dueltheory.com,https://www.dueltheory.com,http://localhost:5173,http://127.0.0.1:5197,https://localhost,http://127.0.0.1:5199"},
 "observability":{"enabled":true,"traces":{"enabled":true}}
}
