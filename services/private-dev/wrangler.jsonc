{
  "$schema": "../commander/node_modules/wrangler/config-schema.json",
  "name": "dueltheory-private-dev",
  "main": "worker.ts",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "../../dist-private",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "MATCH_SERVICE",
      "service": "dueltheory-matches"
    },
    {
      "binding": "TABLE_SERVICE",
      "service": "dueltheory-commander"
    }
  ],
  "vars": {
    "PRIVATE_ACCESS_TEAM": "https://icy-wood-652b.cloudflareaccess.com",
    "PRIVATE_ACCESS_AUD": "6e04bd166b1a91e097ba4feb47eccd0e37289bf249f2cb7902a29643cfb137f1"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "secrets": {
    "required": [
      "PRIVATE_ACCESS_EMAILS"
    ]
  }
}
